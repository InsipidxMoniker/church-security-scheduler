# Local review: loopback only; Caddy issues a local certificate for localhost.
APP_ORIGIN=https://localhost:8443
SITE_ADDRESS=localhost
BIND_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Local direct mode: leave empty; forwarding headers are ignored.
# Optional Tunnel visitor-IP restoration: requires the exact cloudflared LXC
# source /32 or /128 observed by Caddy; blank keeps using the TCP peer address.
# Example only: CLOUDFLARED_TRUSTED_PROXIES=192.0.2.10/32
# This controls header trust only, not origin access. Never trust private_ranges,
# a whole LAN, or a shared Docker NAT gateway without enforcing LXC source before NAT.
CLOUDFLARED_TRUSTED_PROXIES=
# No passwords, real volunteer information, or encryption keys belong here.
MAX_BODY_BYTES=1048576
CSV_MAX_BYTES=500000
# Staff password/MFA limits; windows are seconds. All values must be positive.
AUTH_ACCOUNT_LIMIT=5
AUTH_ACCOUNT_WINDOW=900
AUTH_IP_LIMIT=30
AUTH_IP_WINDOW=300
# Volunteer security defaults; windows are seconds. All values must be positive.
PIN_ACCOUNT_LIMIT=5
PIN_ACCOUNT_WINDOW=900
PIN_IP_LIMIT=30
PIN_IP_WINDOW=300
PIN_GLOBAL_LIMIT=120
ROSTER_IP_LIMIT=60
